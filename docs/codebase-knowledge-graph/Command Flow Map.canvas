		{"id":"install-lock","type":"text","text":"## Current lock?\nCheck whether `Prolfile.lock` exists and matches dependency intent.","x":400,"y":20,"width":300,"height":180},
		{"id":"install-store","type":"text","text":"## Store fast path\nVerify locked packages already exist in the local store.","x":820,"y":20,"width":300,"height":180},
		{"id":"install-done","type":"text","text":"## Done\nCurrent lock plus complete local store means no network fetch.","x":820,"y":280,"width":300,"height":180,"color":"4"},
		{"id":"install-resolve","type":"text","text":"## Resolve\nQuery registry, SWI index, or command-provided source override.","x":400,"y":300,"width":300,"height":180},
		{"id":"install-verify","type":"text","text":"## Verify SHA-256\nAlways verify before unpacking, including cache hits.","x":400,"y":580,"width":300,"height":180,"color":"3"},
		{"id":"install-unpack","type":"text","text":"## Safe unpack\nExtract into `~/.prolm/store/<name>/<version>/` with limits and path defenses.","x":820,"y":560,"width":300,"height":200},
		{"id":"install-write-lock","type":"text","text":"## Persist\nWrite deterministic lock metadata atomically.","x":820,"y":820,"width":300,"height":140},
		{"id":"run-start","type":"text","text":"# `prolm run [entry]`\nRead manifest entry, runtime, scripts, and runtime flags.","x":1420,"y":20,"width":320,"height":180},
		{"id":"publish-start","type":"text","text":"# `prolm publish`\nRegistry-era command begins with pre-flight checks.","x":20,"y":1180,"width":300,"height":160},
		{"id":"publish-preflight","type":"text","text":"## Pre-flight\nManifest valid, version unpublished, git tag at HEAD, clean tree, check pass, lock committed.","x":400,"y":1180,"width":340,"height":240},
		{"id":"run-lock","type":"text","text":"## Lock metadata\nRead exact dependency versions from `Prolfile.lock`.","x":1820,"y":20,"width":300,"height":160},
		{"id":"run-store","type":"text","text":"## Installed deps\nVerify locked package paths exist in the store.\nMissing deps hint: run install first.","x":2220,"y":20,"width":300,"height":200},
		{"id":"run-args","type":"text","text":"## Build invocation\nUse runtime argument arrays for dependency module loads, entry load, goal, and Prolog args.","x":1820,"y":340,"width":360,"height":220},
		{"id":"run-exec","type":"text","text":"## Execute runtime\nReplace or run the selected Prolog runtime with assembled arguments.","x":1820,"y":680,"width":360,"height":180,"color":"4"},
		{"id":"publish-tarball","type":"text","text":"## Build tarball\nPackage source files, manifest, and README.","x":820,"y":1180,"width":300,"height":180},
		{"id":"publish-dry-run","type":"text","text":"## Dry run branch\nPrint manifest details and exit without upload.","x":820,"y":1460,"width":300,"height":160,"color":"3"},
		{"id":"publish-token","type":"text","text":"## Credentials\nLoad publish token or explain `prolm login` requirement.","x":400,"y":1540,"width":340,"height":180},
		{"id":"publish-post","type":"text","text":"## Upload\nPOST archive to registry API over HTTPS.","x":20,"y":1540,"width":300,"height":160},
		{"id":"publish-registry","type":"text","text":"## Registry\nValidate, store archive bytes, and index metadata.","x":20,"y":1820,"width":300,"height":180},
		{"id":"publish-done","type":"text","text":"## Published\nReturn published package result.","x":400,"y":1840,"width":300,"height":140,"color":"4"},
		{"id":"mvs-input","type":"text","text":"# Requirements\nDirect constraints plus transitive dependency constraints.","x":1420,"y":1180,"width":320,"height":180},
		{"id":"mvs-collect","type":"text","text":"## Collect\nGroup all requirements by package across the graph.","x":1840,"y":1180,"width":320,"height":180},
		{"id":"mvs-select","type":"text","text":"## Select\nTake the maximum of the minimum requirements that satisfy constraints.","x":2240,"y":1180,"width":300,"height":200},
		{"id":"mvs-example","type":"text","text":"## Example\n`http`: `^7.0` plus `^7.1`\nresolves to a satisfying `7.1.x` selection.","x":1840,"y":1500,"width":320,"height":200},
		{"id":"mvs-guard","type":"text","text":"## Guards\nNo silent major-version jump.\nNo `latest` in lockfiles.\nYanked versions are visible.","x":2240,"y":1500,"width":300,"height":220,"color":"3"},
		{"id":"mvs-lock","type":"text","text":"## Lock selection\nPersist exact source, version, checksum, and dependency metadata.","x":1840,"y":1840,"width":360,"height":180,"color":"4"},
		{"id":"install-cache","type":"text","text":"## Cache check\nFor each pack, reuse archive bytes only when checksum verification still passes.","x":-60,"y":300,"width":300,"height":200},
		{"id":"install-fetch","type":"text","text":"## Fetch\nDownload missing archive bytes into the cache.","x":-60,"y":580,"width":300,"height":160},
		{"id":"install-start","type":"text","text":"# `prolm install`\nRead `Prolfile.toml`\nParse dependencies and dev dependencies.","x":-80,"y":20,"width":300,"height":180}
	],
